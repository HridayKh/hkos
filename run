#!/usr/bin/env bash
set -e

DISK_IMG="build/disk.img"
BOOTLOADER_BIN="build/bootloader.bin"
KERNEL_BIN="build/kernel.bin"
CFLAGS="-target i686-unknown-none-elf -ffreestanding -fno-builtin -fno-pie -nostdlib -O3 -Wall -Wextra"
SRCS=(
  "src/kernel/main.c"
  "src/kernel/memory.c"
  "src/kernel/vga.c"
  "src/kernel/io.c"
)



echo "[1/5] Preparing build directory..."
rm -rf "build"
mkdir -p "build"



echo "[2/5] Assembling 16-bit Bootloader..."
nasm -f bin -i src/boot/ src/boot/boot.asm -o "${BOOTLOADER_BIN}"



echo "[3/5] Compiling C Kernel Source Files..."
OBJS=()
for src in "${SRCS[@]}"; do
	filename=$(basename "$src" .c)
	obj="build/${filename}.o"
	echo "  CC  $src -> $obj"
	clang ${CFLAGS} -c "$src" -o "$obj"
	OBJS+=("$obj")
done



echo "[4/5] Linking Kernel Binary at 0x100000..."
ld.lld -m elf_i386 -T linker.ld --oformat=binary "${OBJS[@]}" -o "${KERNEL_BIN}"



echo "[5/5] Generating Raw Disk Image..."
dd if=/dev/zero of="${DISK_IMG}" bs=1M count=10 status=none
dd if="${BOOTLOADER_BIN}" of="${DISK_IMG}" conv=notrunc status=none

dd if="${KERNEL_BIN}" of="${DISK_IMG}" bs=512 seek=2048 conv=notrunc status=none




echo "[DONE] Starting Qemu..."
qemu-system-i386 -drive file=${DISK_IMG},format=raw


